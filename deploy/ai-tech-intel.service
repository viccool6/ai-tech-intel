# Nightly ingestion — runs run.py once. Paired with ai-tech-intel.timer.
#
# Install both files together:
#   sudo cp deploy/ai-tech-intel.service deploy/ai-tech-intel.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ai-tech-intel.timer
#
# The unit does NOT run on its own — the timer decides when.

[Unit]
Description=AI Tech Intel — periodic ingestion (fetch + AI + translate)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=<SYSTEM_USER>
Group=<SYSTEM_USER>
WorkingDirectory=<APP_PATH>
# .env is loaded by run.py via python-dotenv (see load_dotenv() at the top
# of run.py). Systemd's EnvironmentFile parser rejects values with
# unquoted spaces/semicolons/parens (e.g. USER_AGENT), so we let dotenv
# handle it. One parser end-to-end.
# --hours 24 matches the timer cadence; adjust if you change OnCalendar.
ExecStart=<APP_PATH>/.venv/bin/python run.py --hours 24
# Cap a single run at 45 min — if the fetch/AI/translate cycle hangs,
# systemd kills the process. This has NOTHING to do with overlap
# prevention: systemd already refuses to re-fire a unit while it's
# active/starting, and the timer silently skips triggers that arrive
# during an ongoing run. This setting exists purely so a stuck HTTP
# call or infinite loop doesn't sit forever.
TimeoutStartSec=45min

# Same hardening posture as the web unit.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=<APP_PATH>/data
